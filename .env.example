# Copy to .env.local for development. Never commit .env.local.
# Every variable here must also be set in the Vercel project settings.

# ---------------------------------------------------------------------------
# Payload
# ---------------------------------------------------------------------------

# Signs session tokens and reset links. Generate with:
#   openssl rand -base64 32
# Changing it logs every admin out. Use a DIFFERENT value in production than
# in development. A shared secret means a development token is valid on live.
PAYLOAD_SECRET=

# Neon Postgres connection string, from the Neon dashboard.
# Region: use Singapore (aws-ap-southeast-1). Neon has no India region, and the
# region CANNOT be changed after the project is created. See SETUP.md section 3.
# Use the POOLED connection ("-pooler" in the host), serverless functions open
# far more connections than a direct Postgres endpoint will tolerate.
# Must include sslmode=require.
#   postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/cognovea?sslmode=require
DATABASE_URI=

# The DIRECT (unpooled) string for the same database, the identical URL with
# "-pooler" removed from the host.
#
# Only used when running `npm run migrate` or `npm run migrate:create`. Neon's
# transaction pooling drops session state between statements, so it does not
# support the SET statements, advisory locks and temporary tables that schema
# migrations rely on. The Payload config switches to this automatically for
# those commands and uses the pooled string for everything else, so there is no
# variable to swap by hand.
#
# Optional. If left empty, migrations run over the pooled endpoint and print a
# warning; they may work, and may hang.
DATABASE_URI_UNPOOLED=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------

# The public origin, no trailing slash. Used for CORS, CSRF and absolute URLs
# in emails. Set to http://localhost:3000 locally.
NEXT_PUBLIC_SERVER_URL=https://cognovea.com

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------

# Vercel Blob read/write token. Created by adding Blob storage to the Vercel
# project; Vercel injects this automatically once linked.
# Leave EMPTY locally, uploads then go to public/uploads on disk, which is
# fine for development and impossible on serverless.
BLOB_READ_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# Analytics
# ---------------------------------------------------------------------------

# GA4 measurement ID, e.g. G-XXXXXXXXXX.
# Leave EMPTY to disable analytics entirely, with no ID, neither the GA script
# nor the consent banner is rendered at all.
NEXT_PUBLIC_GA_ID=
