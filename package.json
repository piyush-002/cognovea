{
  "name": "cognovea-website",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Cognovea — SEO-friendly 10-page marketing site (Next.js App Router, static export).",
  "scripts": {
    "dev": "payload generate:importmap && next dev",
    "devsafe": "rm -rf .next && payload generate:importmap && next dev",
    "build": "payload generate:importmap && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check:boundaries": "node tools/check-boundaries.mjs",
    "art": "node tools/gen-art.mjs",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "migrate:create": "payload migrate:create",
    "migrate": "payload migrate",
    "test:db-endpoint": "node tools/test-db-endpoint.mjs",
    "test:sticky": "node tools/test-sticky.mjs",
    "audit": "node tools/audit.mjs",
    "test:media-url": "node tools/test-media-url.mjs",
    "test:origins": "node tools/test-origins.mjs",
    "test:reveal": "node tools/test-reveal.mjs",
    "test:css-order": "node tools/test-css-order.mjs",
    "test:testimonial-pick": "node tools/test-testimonial-pick.mjs",
    "check:content": "node tools/check-content.mjs",
    "test:hero": "node tools/test-hero.mjs",
    "test:errors": "node tools/test-error-describe.mjs",
    "test:push-guard": "node tools/test-push-guard.mjs",
    "test:canonical": "node tools/test-canonical.mjs",
    "test:titles": "node tools/test-titles.mjs",
    "test:currency": "node tools/test-currency.mjs",
    "test:jsonld": "node tools/test-jsonld.mjs",
    "test:headers": "node tools/test-headers.mjs",
    "test:ssr": "node tools/test-ssr.mjs",
    "test:overflow": "node tools/test-overflow.mjs",
    "test:calculator": "node tools/test-calculator.mjs",
    "test:calculator-ui": "node tools/test-calculator-ui.mjs",
    "test:tool-lead": "node tools/test-tool-lead.mjs",
    "test:summary-print": "node tools/test-summary-print.mjs",
    "test:notify": "node tools/test-notify.mjs",
    "test:rate-limit": "node tools/test-rate-limit.mjs",
    "check:cycles": "node tools/check-cycles.mjs",
    "test:mark": "node tools/test-mark.mjs",
    "test:talkbar": "node tools/test-talkbar.mjs",
    "trace:mark": "node tools/trace-mark.mjs",
    "check:playbooks": "node tools/check-playbooks.mjs",
    "test:nav": "node tools/test-nav.mjs",
